{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "9router-claude",
    "9router-sol",
    "9router-kimi",
    "openrouter-oss"
  ],
  "model": "9router-claude/cap/claude-opus-5",
  "small_model": "9router-sol/cx/gpt-5.6-luna",
  "agent": {
    "plan": {
      "model": "openrouter-oss/openai/gpt-oss-20b",
      "temperature": 0
    }
  },
  "provider": {
    "9router-claude": {
      "npm": "@ai-sdk/anthropic",
      "name": "9Router Claude (Native)",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk_9router",
        "headers": {
          "User-Agent": "claude-code/opencode-native",
          "x-app": "cli"
        }
      },
      "models": {
        "cap/claude-opus-5": {
          "name": "Opus 5",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "low"
            },
            "medium": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "medium"
            },
            "high": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "high"
            },
            "xhigh": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "xhigh"
            },
            "max": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            }
          }
        },
        "cap/claude-sonnet-5": {
          "name": "Sonnet 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "low"
            },
            "medium": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "medium"
            },
            "high": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "high"
            },
            "xhigh": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "xhigh"
            },
            "max": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            }
          }
        },
        "cap/claude-fable-5": {
          "name": "Fable 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "low"
            },
            "medium": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "medium"
            },
            "high": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "high"
            },
            "xhigh": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "xhigh"
            },
            "max": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            }
          }
        },
        "cap/claude-haiku-4-5-20251001": {
          "name": "Haiku",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            },
            "max": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 31999
              }
            }
          }
        }
      }
    },
    "9router-sol": {
      "npm": "@ai-sdk/openai",
      "name": "9Router GPT Sol (Native)",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk_9router",
        "headers": {
          "User-Agent": "codex-cli/opencode-native"
        }
      },
      "models": {
        "cx/gpt-5.6-sol": {
          "name": "GPT Sol",
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        },
        "cx/gpt-5.6-luna": {
          "name": "GPT Luna",
          "options": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        }
      }
    },
    "9router-kimi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Kimi (Native)",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "kimi/kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "kimi/kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "openrouter-oss": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter GPT-OSS",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{file:./openrouter.key}",
        "headers": {
          "X-Title": "OpenCode Plan"
        }
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B",
          "limit": {
            "context": 131072,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow"
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "node",
        "--eval",
        "import(require('node:url').pathToFileURL(require('node:path').join(require('node:os').homedir(),'.config','opencode','lib','codebase-memory-launcher.mjs')).href).then((module)=>module.launchCodebaseMemory())"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/9router-autostart.mjs",
    "./plugins/9router-model-guard.mjs",
    "./plugins/caveman/plugin.js",
    "./plugins/ponytail-lock.mjs",
    "./plugins/graphify.js",
    "./plugins/claude-mem-wrapper.mjs",
    "./plugins/claude-mem-autostart.mjs",
    "./plugins/project-docs-hook.mjs",
    "./plugins/prompt-enhancer-hook.mjs"
  ]
}
