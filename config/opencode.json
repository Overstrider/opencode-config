{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "9router"
  ],
  "model": "9router/cc/claude-opus-5",
  "small_model": "9router/cc/claude-haiku-4-5-20251001",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router (Local)",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "cc/claude-opus-5": {
          "name": "Opus 5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "cc/claude-sonnet-5": {
          "name": "Sonnet 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "cc/claude-fable-5": {
          "name": "Fable 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "cx/gpt-5.6-sol": {
          "name": "GPT Sol",
          "limit": {
            "context": 372000,
            "output": 128000
          }
        },
        "kimi/kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "cc/claude-haiku-4-5-20251001": {
          "name": "Haiku",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow"
  }
}
