{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "copilot"
  ],
  "model": "copilot/gpt-5.4",
  "small_model": "copilot/gpt-5.4",
  "agent": {
    "plan": {
      "model": "copilot/gpt-5.4",
      "temperature": 0
    }
  },
  "provider": {
    "copilot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Copilot Direct",
      "options": {
        "baseURL": "https://api.githubcopilot.com",
        "apiKey": "{file:./copilot.key}",
        "headers": {
          "Editor-Version": "vscode/1.100.0",
          "Copilot-Integration-Id": "vscode-chat"
        }
      },
      "models": {
        "gpt-5.4": {
          "name": "Copilot GPT-5.4",
          "limit": {
            "context": 128000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow"
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "node",
        "--eval",
        "import(require('node:url').pathToFileURL(require('node:path').join(require('node:os').homedir(),'.config','opencode','lib','codebase-memory-launcher.mjs')).href).then((module)=>module.launchCodebaseMemory())"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "./plugins/ponytail-lock.mjs",
    "./plugins/graphify.js",
    "./plugins/project-docs-hook.mjs"
  ]
}
