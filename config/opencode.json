{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "9router-sol",
    "9router-kimi",
    "9router-sakana",
    "9router-qwen"
  ],
  "model": "9router-qwen/openrouter/qwen/qwen3.7-flash",
  "small_model": "9router-sol/cx/gpt-5.6-luna",
  "agent": {
    "plan": {
      "model": "9router-sol/cx/gpt-5.6-sol",
      "variant": "high"
    }
  },
  "provider": {
    "9router-sol": {
      "npm": "@ai-sdk/openai",
      "name": "9Router GPT Sol (Merlin Remote)",
      "options": {
        "baseURL": "https://merlin.loldinis.com/v1",
        "apiKey": "{file:./9router-merlin.key}",
        "headers": {
          "User-Agent": "codex-cli/opencode-native"
        }
      },
      "models": {
        "cx/gpt-5.6-sol": {
          "name": "GPT Sol",
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        },
        "cx/gpt-5.6-luna": {
          "name": "GPT Luna",
          "options": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "limit": {
            "context": 372000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        }
      }
    },
    "9router-kimi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Kimi (Merlin Remote)",
      "options": {
        "baseURL": "https://merlin.loldinis.com/v1",
        "apiKey": "{file:./9router-merlin.key}"
      },
      "models": {
        "kimi/kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "kimi/kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "9router-qwen": {
      "npm": "@ai-sdk/openai",
      "name": "9Router Qwen (Merlin Remote)",
      "options": {
        "baseURL": "https://merlin.loldinis.com/v1",
        "apiKey": "{file:./9router-merlin.key}"
      },
      "models": {
        "openrouter/qwen/qwen3.7-flash": {
          "name": "Qwen 3.7 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "9router-sakana": {
      "npm": "@ai-sdk/openai",
      "name": "9Router Sakana Fugu (Merlin Remote)",
      "options": {
        "baseURL": "https://merlin.loldinis.com/v1",
        "apiKey": "{file:./9router-merlin.key}"
      },
      "models": {
        "sakana/fugu": {
          "name": "Fugu",
          "limit": {
            "context": 1000000,
            "output": 1000000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "sakana/fugu-ultra": {
          "name": "Fugu Ultra",
          "limit": {
            "context": 1000000,
            "output": 1000000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "sakana/fugu-ultra-20260615": {
          "name": "Fugu Ultra v1.0",
          "limit": {
            "context": 1000000,
            "output": 1000000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow"
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "node",
        "--eval",
        "import(require('node:url').pathToFileURL(require('node:path').join(require('node:os').homedir(),'.config','opencode','lib','codebase-memory-launcher.mjs')).href).then((module)=>module.launchCodebaseMemory())"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "./plugins/ponytail-lock.mjs",
    "./plugins/subagent-variant-default.mjs",
    "./plugins/graphify.js",
    "./plugins/claude-mem-wrapper.mjs",
    "./plugins/claude-mem-autostart.mjs",
    "./plugins/project-docs-hook.mjs",
    "./plugins/prompt-enhancer-hook.mjs"
  ]
}
